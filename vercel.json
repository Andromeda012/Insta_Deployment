{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/r2/:key*", "destination": "/api/module8?action=r2-media&key=:key*" },
    { "source": "/api/webhooks/clerk", "destination": "/api/module7?action=clerk-webhook" },
    { "source": "/api/clerk-session", "destination": "/api/module7?action=clerk-session" },
    { "source": "/api/b2c-lazy-quote", "destination": "/api/module7?action=b2c-lazy-quote" },
    { "source": "/api/crm-customers", "destination": "/api/module7?action=crm-customers" },
    { "source": "/api/telemetry-health", "destination": "/api/module7?action=telemetry-health" },
    { "source": "/api/product-analytics", "destination": "/api/module7?action=product-analytics" },
    { "source": "/_data/:match*", "destination": "/Module%201/_data/:match*" },
    { "source": "/nova-studio-engine.js", "destination": "/Module%202/nova-studio-engine.js" },
    { "source": "/panoramic-carousel-engine.js", "destination": "/Module%202/panoramic-carousel-engine.js" },
    { "source": "/api/module2-state", "destination": "/api/module2?action=state" },
    { "source": "/api/module2-enqueue", "destination": "/api/module2?action=enqueue" },
    { "source": "/api/module2-cancel", "destination": "/api/module2?action=cancel" },
    { "source": "/api/youtube-cron", "destination": "/api/module2?action=youtube-cron" },
    { "source": "/api/instagram-render", "destination": "/api/render?platform=instagram" },
    { "source": "/api/facebook-render", "destination": "/api/render?platform=facebook" },
    { "source": "/api/tiktok-render", "destination": "/api/render?platform=tiktok" },
    { "source": "/api/youtube-render", "destination": "/api/render?platform=youtube" }
  ],
  "functions": {
    "api/instagram-cron.js": { "maxDuration": 60 },
    "api/facebook-cron.js": { "maxDuration": 60 },
    "api/tiktok-cron.js": { "maxDuration": 60 }
  }
}
