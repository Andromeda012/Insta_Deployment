# ============================================================================
# GLOBAL MOBİLYA — VPS PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# ============================================================================
# ÖNEMLİ KURAL:
# Bu aşama yalnızca Sosyal Medya Yayınlama Sistemi (Instagram, Facebook, TikTok)
# içindir. Gerçek değerleri sunucuya SSH ile bağlandıktan sonra '.env' içine yazınız.
# Asla şifre veya gerçek tokenları git reposuna eklemeyiniz.
# ============================================================================

# ── 1. SUPABASE BAĞLANTISI (ZORUNLU) ──────────────────────────────────────────
# Worker'ın RLS kısıtlamalarına takılmadan görev kuyruğunu tüketebilmesi için
# Project Settings > API > service_role (secret) anahtarı gereklidir.
SUPABASE_URL=https://vrfujrpsjzqjthaqdalx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY

# ── 2. META GRAPH API (INSTAGRAM & FACEBOOK YAYINLARI) ───────────────────────
# Meta Business Manager > Sistem Kullanıcısı (System User) üzerinden üretilmiş
# süresiz veya 60 günlük geçerli Page Access Token
META_PAGE_ID=YOUR_FACEBOOK_PAGE_ID
META_IG_USER_ID=17841435882645322
META_PAGE_ACCESS_TOKEN=YOUR_LONG_LIVED_META_PAGE_ACCESS_TOKEN

# ── 3. TIKTOK CONTENT POSTING API v2 (TIKTOK YAYINLARI) ──────────────────────
TIKTOK_OPEN_ID=YOUR_TIKTOK_OPEN_ID
TIKTOK_ACCESS_TOKEN=YOUR_TIKTOK_ACCESS_TOKEN
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET
TIKTOK_REFRESH_TOKEN=YOUR_TIKTOK_REFRESH_TOKEN

# ── 4. GOOGLE & YOUTUBE DATA API v3 (GELİŞTİRME AŞAMASINDA - OPSİYONEL) ───────
YOUTUBE_CHANNEL_ID=UC_NovaFurniture
YOUTUBE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
YOUTUBE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
YOUTUBE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN

# ── 5. ÇALIŞMA VE KUYRUK PARAMETRELERİ ───────────────────────────────────────
DRY_RUN=false
POLL_INTERVAL_SECONDS=15
LOCK_DURATION_SECONDS=180
TZ=Europe/Istanbul

# ── 6. 2. AŞAMA DEĞİŞKENLERİ (BU AŞAMADA DEVREYE ALINMAYACAK / GEREKSİZ) ─────
# META_WEBHOOK_VERIFY_TOKEN=global_kapak_insta_verify_2026
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
