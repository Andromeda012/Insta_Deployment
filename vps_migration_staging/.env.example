# ============================================================================
# NOVA — VPS PUBLISHER ENVIRONMENT VARIABLES (.env.example)
# ============================================================================
# ÖNEMLİ KURAL:
# Bu aşama yalnızca Sosyal Medya Yayınlama Sistemi (Instagram ve Facebook)
# içindir. Gerçek değerleri sunucuya SSH ile bağlandıktan sonra '.env' içine yazınız.
# Asla şifre veya gerçek tokenları git reposuna eklemeyiniz.
# ============================================================================

# ── 1. SUPABASE BAĞLANTISI (ZORUNLU) ──────────────────────────────────────────
# Worker'ın RLS kısıtlamalarına takılmadan görev kuyruğunu tüketebilmesi için
# Project Settings > API > service_role (secret) anahtarı gereklidir.
SUPABASE_URL=https://vrfujrpsjzqjthaqdalx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY

# ── 2. META GRAPH API (INSTAGRAM & FACEBOOK YAYINLARI) ───────────────────────
# Meta Instagram Graph API Bilgileri (insta_bot_state.config.access_token)
META_IG_USER_ID=17841435882645322
META_IG_ACCESS_TOKEN=YOUR_LONG_LIVED_INSTAGRAM_ACCESS_TOKEN

# Meta Facebook Page Graph API Bilgileri (fb_bot_state.config.page_access_token)
META_PAGE_ID=YOUR_FACEBOOK_PAGE_ID
META_PAGE_ACCESS_TOKEN=YOUR_LONG_LIVED_META_PAGE_ACCESS_TOKEN

# ── 3. ÇALIŞMA VE KUYRUK PARAMETRELERİ ───────────────────────────────────────
DRY_RUN=true
POLL_INTERVAL_SECONDS=15
LOCK_DURATION_SECONDS=180
TZ=Europe/Istanbul

# ── 4. GEMINI BANANA (GÖRSEL SAHNELEME & RECONTEXTUALIZATION) ─────────────
# Ürün görsellerini İskandinav lüks mimari sahneye yerleştiren Gemini/Imagen motoru için API anahtarı
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# ── 5. DEVRE DIŞI / 2. AŞAMA DEĞİŞKENLERİ ─────────────────────────────────────
# META_WEBHOOK_VERIFY_TOKEN=global_kapak_insta_verify_2026
