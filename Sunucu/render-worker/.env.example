# ============================================================================
# GLOBAL MOBİLYA — MODÜL 8 RENDER WORKER ENVIRONMENT TEMPLATE
# ============================================================================
# Önerilen Kurulum Yolu: /opt/nova-worker/.env
# ============================================================================

NODE_ENV=production
SERVICE_NAME=nova-render-worker
TZ=Europe/Istanbul

# Vercel Production API Base URL (Örn: https://andromeda-mobilya.vercel.app)
API_BASE_URL=https://your-production-app.vercel.app

# Güvenli Worker Erişim Anahtarı (API ile Worker arasındaki iletişimi doğrular)
# Üretim için önerilen komut: openssl rand -hex 32
RENDER_WORKER_KEY=change_this_to_a_secure_random_64_character_hex_token

# Blender Headless CPU Render Sınırları ($12 DigitalOcean VPS için optimize)
BLENDER_DEVICE=CPU
CYCLES_CPU_THREADS=1
BLENDER_NICE_LEVEL=19
POLL_INTERVAL_MS=10000

# Host Güvenlik Eşikleri (Yayıncı 'nova-publisher' servisini koruma eşikleri)
MAX_HOST_LOAD_AVG=2.5
MIN_FREE_MEM_MB=256
