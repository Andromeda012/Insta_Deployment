# ============================================================================
# GLOBAL MOBİLYA — MODÜL 8 RENDER WORKER ENVIRONMENT TEMPLATE (PRODUCTION)
# ============================================================================
# Önerilen Kurulum Yolu: /opt/nova-worker/.env
# ============================================================================

NODE_ENV=production
SERVICE_NAME=nova-render-worker
TZ=Europe/Istanbul

# Vercel Production API Base URL (Zorunlu — Production'da localhost yasaktır)
API_BASE_URL=https://your-production-app.vercel.app

# Güvenli Worker Erişim Anahtarı (Zorunlu — En az 32 byte önerilir)
# Üretim komutu: openssl rand -hex 32
RENDER_WORKER_KEY=change_this_to_a_secure_random_64_character_hex_token

# Supabase Veritabanı ve Storage Bağlantısı (Yalnızca Backend / Worker Ortamı İçindir!)
# GÜVENLİK KURALI: SUPABASE_SERVICE_ROLE_KEY asla frontend/client tarafına eklenmemelidir!
SUPABASE_URL=https://vrfujrpsjzqjthaqdalx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_never_expose_to_client
SUPABASE_STORAGE_BUCKET=media

# Simülasyon Modu (Production'da her zaman kapalıdır)
RENDER_SIMULATION_MODE=false

# Blender Headless CPU Render Sınırları (1 vCPU / ~2 GB RAM DigitalOcean VPS için)
BLENDER_BIN=blender
BLENDER_DEVICE=CPU
CYCLES_CPU_THREADS=1
BLENDER_NICE_LEVEL=19
RENDER_TIMEOUT_MS=300000
WORKER_API_TIMEOUT_MS=30000
WORKER_LEASE_SECONDS=360
POLL_INTERVAL_MS=10000

# Host Güvenlik Eşikleri (Yayıncı 'nova-publisher' servisini koruma eşikleri)
MAX_LOAD_AVG=1.5
MIN_FREE_MEM_MB=350
